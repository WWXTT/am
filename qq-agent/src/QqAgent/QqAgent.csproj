<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>qq-agent</AssemblyName>
    <RootNamespace>QqAgent</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 2026-10-28 回滚：ZCode 阶段3 的 app.manifest（PerMonitorV2）把整进程坐标系从旧虚拟化空间
         （win-lock/布局按它标定，如 9864,500）换成物理像素（0..5760），旧锁变屏外，
         daemon 每 12s 把 QQ 往屏外拽、系统又夹回主屏。恢复原有 SetProcessDPIAware 路径。 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- WASAPI 定向播放（语音条回环注入）。手写 IAudioClient interop 的 Initialize 在
         .NET10 调用桩被拒（ArgumentException，2026-10-25 实测），换 NAudio 成熟实现。 -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
